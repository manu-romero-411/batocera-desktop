#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# bd-session - privileged part of batocera-desktop (runs as root)
#
#   launch   (via sudo, passwordless)  validate the caller's parameters, then exec `run`
#   run      the session loop (restarts after ES "reboot"). Two ways to get here:
#              * launch  -> manual start, foreground, Ctrl+C ends it; mode nested or drm
#                           (drm: the caller's own console, or a free one claimed with --tty)
#              * the systemd unit -> service start: drm on the first free VT >= BD_TTY_MIN (default 8)
#   inner    PID 1 of the namespace: mount layers, start services, wait, clean up
#   shell|enter [-- cmd]   Batocera environment without starting services (maintenance)
#   update | install | doctor | apply-pending | detect (no root: hardware + which variants fit)
set -u
BD_PREFIX=${BD_PREFIX:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}
# shellcheck source=../lib/bd-common.sh
. "$BD_PREFIX/lib/bd-common.sh"
bd_load_config

SVC_STARTED=()
BD_STOP=0
BD_ACTION="exit"
BD_RC=0
BD_HOST_DOWN=0
BD_OWNVT=0
BD_ENV=()
BD_UNSHARE=()
DISPLAY=:1

need_root() { [[ $EUID -eq 0 ]] || die "must run as root (sudo)"; }

# bd_unshare_args [extra unshare options...] -> fills BD_UNSHARE with the namespace command
# (private mount + UTS, and PID namespace unless BD_PIDNS=0)
bd_unshare_args() {
    BD_UNSHARE=(unshare --mount --uts --propagation slave)
    if ((BD_PIDNS)); then BD_UNSHARE+=(--pid --fork "$@"); fi
}

# ============================================================ launch (sudo)
cmd_launch() {
    need_root
    local uid=${SUDO_UID:-} wl="" xdg="" xl="" xv="" mode="" tty="" fs=0 claim=0 n
    [[ -n $uid && $uid != 0 ]] || die "run it as your desktop user (through sudo), not as root"
    while (($#)); do
        case $1 in
        --mode)
            mode=${2:-}
            shift 2
            ;;
        --tty)
            tty=${2:-}
            shift 2
            ;;
        --wayland)
            wl=${2:-}
            shift 2
            ;;
        --xdg)
            xdg=${2:-}
            shift 2
            ;;
        --xkb-layout)
            xl=${2:-}
            shift 2
            ;;
        --xkb-variant)
            xv=${2:-}
            shift 2
            ;;
        --fullscreen)
            fs=${2:-0}
            shift 2
            ;;
        *) die "unknown argument: $1" ;;
        esac
    done
    [[ $xdg == "/run/user/$uid" ]] || die "unexpected XDG_RUNTIME_DIR: '$xdg'"
    [[ $fs == [01] ]] || die "invalid --fullscreen value"
    case $mode in
    nested)
        ((P_NESTED)) || die "variant $BD_VARIANT is X11-only: nested mode is not available for it (start it on a text console, drm/tty mode, or with the systemd service)"
        [[ $wl =~ ^wayland-[0-9]+$ ]] || die "invalid Wayland display name: '$wl'"
        [[ -S $xdg/$wl ]] || die "Wayland socket $xdg/$wl does not exist (is this a Wayland session?)"
        tty=""
        ;;
    drm)
        # passwordless sudo: the VT must be a real console, either the caller's own (they are logged
        # in on it) or one nobody uses (ssh / `start --tty N`): then the session claims it.
        [[ $tty =~ ^/dev/tty[1-9][0-9]*$ && -c $tty ]] || die "invalid tty: '$tty'"
        if [[ $(stat -c %u "$tty") != "$uid" ]]; then
            n=${tty#/dev/tty}
            [[ $(bd_free_vt "$n" 2>/dev/null) == "$n" ]] ||
                die "$tty is in use by someone else (tty$(bd_free_vt 8 2>/dev/null || echo '?') is free now)"
            claim=1
        fi
        wl=""
        ;;
    *) die "unknown mode: '$mode' (nested|drm)" ;;
    esac
    [[ $xl =~ ^[A-Za-z0-9_,-]*$ && $xv =~ ^[A-Za-z0-9_,-]*$ ]] || die "invalid keyboard layout"
    exec env BD_MODE="$mode" BD_TTY="$tty" BD_UID="$uid" BD_WAYLAND="$wl" BD_XDG="$xdg" \
        BD_XKB_LAYOUT_HOST="$xl" BD_XKB_VARIANT_HOST="$xv" BD_FS="$fs" BD_CLAIM_VT="$claim" \
        "$BD_PREFIX/libexec/bd-session" run
}

# =========================================================== run (the session loop)
# Parameters come from the environment (set by `launch`). With no BD_MODE this is a
# service start: drm on the first free VT >= BD_TTY_MIN, audio of BD_USER.
bd_resolve_session() {
    local n u
    if [[ -z ${BD_MODE:-} ]]; then
        BD_MODE=drm
        BD_SERVICE=1
        if [[ -z ${BD_TTY:-} ]]; then
            n=$(bd_free_vt "$BD_TTY_MIN") || {
                log_warn "no free VT from tty$BD_TTY_MIN up"
                return 1
            }
            BD_TTY=/dev/tty$n
            log_info "service start: using the free console tty$n"
        fi
        BD_FS=0
    fi
    if [[ -z ${BD_UID:-} ]]; then
        u=$(bd_default_user) && BD_UID=$(id -u "$u" 2>/dev/null) || BD_UID=""
        [[ -n $BD_UID ]] && log_info "desktop user for audio: $u (set BD_USER to choose another)"
    fi
    case $BD_MODE in
    nested)
        ((P_NESTED)) || {
            log_warn "variant $BD_VARIANT has no nested mode (X11 build): use a text console or the service"
            return 1
        }
        [[ -n ${BD_WAYLAND:-} ]] || {
            log_warn "nested mode needs a Wayland display"
            return 1
        }
        ;;
    drm)
        [[ ${BD_TTY:-} =~ ^/dev/tty[1-9][0-9]*$ ]] || {
            log_warn "drm mode needs a /dev/ttyN"
            return 1
        }
        [[ ${BD_CLAIM_VT:-0} == 1 ]] && log_info "claiming the free console ${BD_TTY#/dev/}: switching to it, and back when Batocera ends"
        # audio comes from the user's PipeWire: make sure it exists (service start, no login)
        if [[ $BD_AUDIO == host ]]; then
            if [[ -n ${BD_XDG:-} && -d $BD_XDG ]]; then
                : # known already (started from the user's own console)
            elif [[ -n ${BD_UID:-} ]]; then
                if bd_ensure_user_runtime "$BD_UID"; then
                    BD_XDG=/run/user/$BD_UID
                else log_warn "no runtime dir for uid $BD_UID: Batocera will have no audio"; fi
            else
                log_warn "no desktop user found (set BD_USER in /etc/batocera-desktop.conf): Batocera will have NO audio"
            fi
            if [[ -n ${BD_XDG:-} && ! -S $BD_XDG/pulse/native ]]; then
                log_warn "no PipeWire-Pulse socket at $BD_XDG/pulse/native (is pipewire-pulse installed and enabled for that user?): Batocera will have NO audio"
            fi
        fi
        ;;
    *)
        log_warn "unknown mode '$BD_MODE'"
        return 1
        ;;
    esac
    export BD_MODE BD_TTY BD_UID BD_WAYLAND BD_XDG BD_XKB_LAYOUT_HOST BD_XKB_VARIANT_HOST BD_FS
}

# Hard stop if the configured variant does not fit this machine or the image on disk.
# Checked on EVERY start (manual and service), not only at install: disks and configs get moved.
bd_assert_variant() {
    bd_hw_probe
    bd_variant_check "$BD_VARIANT" || die "variant $BD_VARIANT cannot run on this machine: $BD_WHY. Recommended here: $(bd_variant_recommend)"
    bd_assert_image
}

# The image on disk must be the variant we are configured for.
bd_assert_image() {
    local f=$BD_BOOT_DIR/boot b m
    if [[ -f $BD_BOOT_DIR/.bd-variant ]]; then
        m=$(<"$BD_BOOT_DIR/.bd-variant")
        [[ $m == "$BD_VARIANT" ]] || die "the image in $BD_BOOT_DIR was installed as '$m' but BD_VARIANT is '$BD_VARIANT'"
    fi
    if [[ -f $f/batocera.board ]]; then
        b=$(<"$f/batocera.board")
        b=${b//[[:space:]]/}
        bd_board_matches "$b" || die "image board is '$b' but variant $BD_VARIANT expects: $P_BOARDS"
    fi
}

bd_assert_image_quiet() { (bd_assert_image) >/dev/null 2>&1; }

cmd_run() {
    need_root
    bd_assert_variant
    mkdir -p "$BD_LOGDIR"
    exec 9>"$BD_LOCK_FILE"
    flock -n 9 || die "a session is already running"
    rm -f "$BD_ACTION_FILE"
    BD_SERVICE=0
    bd_resolve_session || exit 1
    # a console nobody is logged in on (the service's, or one claimed with `start --tty N`) is ours to
    # manage: no login prompt on it meanwhile, and the previous VT comes back at the end
    BD_OWNVT=0
    if ((BD_SERVICE)) || [[ ${BD_CLAIM_VT:-0} == 1 ]]; then BD_OWNVT=1; fi
    bd_unshare_args --kill-child=SIGTERM
    local act active prev_vt=""
    BD_RUN_STOP=0
    # Ctrl+C / systemctl stop also reach this loop. Without a trap we would die before
    # restoring the VT; with it, bash handles the signal when the child ends.
    trap 'BD_RUN_STOP=1' TERM INT HUP
    if [[ $BD_MODE == drm ]]; then
        # remember the keyboard mode (labwc switches it off) and bring our VT to the front
        python3 "$BD_PREFIX/libexec/bd-vt" save "$BD_TTY" || log_warn "could not read the keyboard mode of $BD_TTY"
        active=$(bd_active_vt || true)
        if [[ $active != "${BD_TTY#/dev/tty}" ]]; then
            prev_vt=$active
            python3 "$BD_PREFIX/libexec/bd-vt" activate "${BD_TTY#/dev/tty}" || log_warn "could not switch to ${BD_TTY##*/}"
        fi
        # keep logind from spawning a login prompt on our VT while we own it
        ((BD_OWNVT)) && bd_reserve_vt "${BD_TTY#/dev/tty}"
    fi
    while :; do
        bd_boot_apply_pending
        "${BD_UNSHARE[@]}" -- "$BD_PREFIX/libexec/bd-session" inner
        # drm: labwc dies with SIGKILL (S31emulationstation stop) and leaves the VT in
        # KD_GRAPHICS + keyboard off + VT_PROCESS -> no keyboard, no VT switching
        if [[ $BD_MODE == drm ]]; then
            python3 "$BD_PREFIX/libexec/bd-vt" reset "$BD_TTY" || log_warn "could not restore VT $BD_TTY"
        fi
        act=$(cat "$BD_ACTION_FILE" 2>/dev/null)
        rm -f "$BD_ACTION_FILE"
        ((BD_RUN_STOP)) && break
        case $act in
        reboot)
            log_info "restarting the Batocera session"
            continue
            ;;
        poweroff-host | reboot-host)
            log_info "BD_CAN_SHUTDOWN: ${act%-host} requested inside Batocera -> ${act%-host} the host"
            if systemctl "${act%-host}"; then
                BD_HOST_DOWN=1
            else
                log_err "systemctl ${act%-host} failed: the host stays up, ending the Batocera session instead"
            fi
            break
            ;;
        *) break ;;
        esac
    done
    # host going down: leave the console as it is (no login prompt / VT flash while it shuts down)
    if ((BD_OWNVT && !BD_HOST_DOWN)); then
        bd_release_vt "${BD_TTY#/dev/tty}"
        # give the screen back: return to the VT we came from
        [[ -n $prev_vt ]] && python3 "$BD_PREFIX/libexec/bd-vt" activate "$prev_vt" 2>/dev/null
    fi
    log_ok "session finished"
}

bd_on_term() { BD_STOP=1; }
bd_on_usr1() { # sent by the shutdown/reboot shims inside the chroot
    local a
    a=$(cat "$BD_ROOT/run/bd-action" 2>/dev/null)
    case $a in
    reboot) if [[ $BD_CAN_SHUTDOWN == true ]]; then BD_ACTION=reboot-host; else BD_ACTION=reboot; fi ;;
    poweroff) if [[ $BD_CAN_SHUTDOWN == true ]]; then BD_ACTION=poweroff-host; else BD_ACTION="exit"; fi ;;
    *) BD_ACTION="exit" ;;
    esac
    BD_STOP=1
}

bd_mount_layers() {
    local o=$BD_RUN/ovl lowers
    mkdir -p "$o"/{base,base2,overlay,work,saved} "$BD_ROOT"
    [[ -f $BD_BOOT_DIR/boot/batocera ]] ||
        die "missing $BD_BOOT_DIR/boot/batocera  (run: batocera-desktop install)"
    if [[ -s $BD_BOOT_DIR/boot/overlay ]]; then # overlay saved with batocera-save-overlay
        if mount -o loop,ro "$BD_BOOT_DIR/boot/overlay" "$o/saved"; then
            cp -a "$o/saved/." "$o/overlay/" || log_warn "could not copy the saved overlay"
            umount "$o/saved"
        else
            log_warn "could not mount boot/overlay (ignored)"
        fi
    fi
    mount -o loop,ro "$BD_BOOT_DIR/boot/batocera" "$o/base" || die "cannot mount boot/batocera"
    lowers=$o/base
    if [[ -f $BD_BOOT_DIR/boot/rufomaculata ]]; then # second layer (the initrd merges both)
        mount -o loop,ro "$BD_BOOT_DIR/boot/rufomaculata" "$o/base2" || die "cannot mount boot/rufomaculata"
        lowers=$lowers:$o/base2
    fi
    mount -t overlay overlay -o "rw,lowerdir=$lowers,upperdir=$o/overlay,workdir=$o/work" "$BD_ROOT" ||
        die "cannot mount the rootfs overlay"
}

bd_mount_runtime() {
    local R=$BD_ROOT P S spec src dst opt
    mkdir -p "$BD_USERDATA"
    bd_bind "$BD_BOOT_DIR" /boot || return 1
    bd_bind "$BD_USERDATA" /userdata || return 1
    mkdir -p "$BD_USERDATA/system/varlog"
    bd_bind "$BD_USERDATA/system/varlog" /var/log || return 1 # keeps labwc.log after a crash
    bd_bind "$BD_RUN/ovl" /overlay "" rec || return 1

    P=$(bd_rpath "$R" /proc)
    mkdir -p "$P"
    mount -t proc -o nosuid,nodev,noexec proc "$P" || return 1
    # Batocera runs sysctl/sysrq: keep it away from the host
    bd_mount_ro "$P/sys" "$P/sys"
    if [[ -e $P/sysrq-trigger ]]; then bd_mount_ro "$P/sysrq-trigger" "$P/sysrq-trigger"; fi

    S=$(bd_rpath "$R" /sys)
    mkdir -p "$S"
    bd_mount_ro /sys "$S"
    bd_bind /dev /dev "" rec || return 1

    P=$(bd_rpath "$R" /run)
    mkdir -p "$P"
    mount -t tmpfs -o mode=0755,nosuid,nodev,size=256M tmpfs "$P" || return 1
    P=$(bd_rpath "$R" /tmp)
    mkdir -p "$P"
    mount -t tmpfs -o mode=1777,nosuid,nodev,size="$BD_TMP_SIZE" tmpfs "$P" || return 1

    [[ -e $(bd_rpath "$R" /var/run) ]] || bd_ln /var/run /run
    [[ -d /run/udev ]] && bd_bind /run/udev /run/udev ro # libudev/SDL: gamepad classification from the host
    if [[ -n ${BD_XDG:-} && -d $BD_XDG ]]; then bd_bind "$BD_XDG" /run/host-xdg; fi
    case $BD_BT in
    host)
        [[ -S /run/dbus/system_bus_socket ]] && bd_bind /run/dbus/system_bus_socket /run/dbus/system_bus_socket
        [[ -d /var/lib/bluetooth ]] && bd_bind /var/lib/bluetooth /var/lib/bluetooth
        ;;
    esac
    [[ $BD_BIND_MEDIA == 1 && -d /media ]] && {
        bd_bind /media /media "" rec
        mount --make-rslave "$(bd_rpath "$R" /media)" 2>/dev/null
    }
    [[ $BD_BIND_MODULES == 1 && -d /lib/modules ]] && bd_bind /lib/modules /lib/modules ro
    for spec in $BD_EXTRA_BINDS; do
        IFS=: read -r src dst opt <<<"$spec"
        [[ -e $src && -n $dst ]] || {
            log_warn "extra bind ignored: $spec"
            continue
        }
        bd_bind "$src" "$dst" "$opt" rec
    done

    # resolv.conf (may be a symlink in the rootfs; replace the leaf, never write through it)
    dst=$(bd_rleaf "$R" /etc/resolv.conf)
    mkdir -p "${dst%/*}"
    rm -f -- "$dst"
    cat /etc/resolv.conf >"$dst" 2>/dev/null
    return 0
}

bd_inject_triggerhappy() {
    # Batocera's stock key map has no volume keys. The S50triggerhappy service sources
    # /etc/default/triggerhappy, so we extend the key map there (writable layer only; the
    # squashfs is never touched). A user-provided /userdata/system/configs/multimedia_keys.conf
    # always wins: add the volume keys to it yourself if you use one.
    local f tmp step=$BD_VOLUME_STEP
    # Batocera's hotkeygen already maps KEY_VOLUMEUP/DOWN/MUTE (default_mapping.conf ->
    # batocera-audio setSystemVolume): with it running, a second handler would double the step.
    if [[ $BD_VOLUME_KEYS == auto ]]; then
        [[ " $BD_SERVICES " == *hotkeygen* ]] && return 0
    elif [[ $BD_VOLUME_KEYS != 1 ]]; then
        return 0
    fi
    [[ $step =~ ^[0-9]+$ ]] || step=5
    f=$(bd_rleaf "$BD_ROOT" /etc/default/triggerhappy) || return 1
    mkdir -p "${f%/*}"
    tmp=$(mktemp)
    {
        [[ -f $f ]] && sed '/^# --- batocera-desktop begin/,$d' "$f"
        sed "s/@STEP@/$step/g" "$BD_PREFIX/share/chroot/etc/default/triggerhappy"
    } >"$tmp"
    rm -f -- "$f"
    install -m 0644 -- "$tmp" "$f"
    rm -f "$tmp"
}

bd_inject_files() {
    local n d l
    if [[ ${BD_MODE:-nested} == nested ]]; then
        bd_put "$BD_PREFIX/share/chroot/usr/bin/labwc-launch" /usr/bin/labwc-launch 0755 || return 1
        # batocera-resolution: the stock one cannot measure the nested labwc output ("unknown")
        bd_shim_install /usr/bin/batocera-resolution usr/bin/batocera-resolution bd-shim-resolution || return 1
        echo "$BD_RESOLUTION" >"$(bd_rpath "$BD_ROOT" /run)/bd-resolution"
    fi
    bd_inject_vt_file
    bd_inject_volume_gate || log_warn "could not install the volume gate: volume keys may act twice while the desktop is in front"
    # drm/tty mode uses Batocera's own launcher and batocera-resolution (real KMS output)
    if [[ $P_DISPLAY == x11 ]]; then
        bd_inject_xorg || return 1
        local md=/usr/lib/xorg/modules
        [[ -d $(bd_rpath "$BD_ROOT" "$md") ]] || md=/usr/lib64/xorg/modules
        bd_x11_gpu_conf "$(bd_rleaf "$BD_ROOT" /etc/X11/xorg.conf.d/10-bd-gpu.conf)" "$md" ||
            log_warn "could not write the Xorg GPU configuration"
    fi
    ((P_LEGACY)) && bd_inject_alsa_pulse
    bd_put "$BD_PREFIX/share/chroot/usr/bin/bd-audio-inherit" /usr/bin/bd-audio-inherit 0755 || return 1
    bd_inject_triggerhappy
    # shutdown shims: ES calls shutdown/poweroff/reboot -> back to the desktop / restart the session
    for d in /sbin /usr/sbin /bin /usr/bin; do
        for n in shutdown poweroff reboot halt; do
            l=$(bd_rleaf "$BD_ROOT" "$d/$n")
            if [[ $d == /sbin || -e $l || -L $l ]]; then
                bd_put "$BD_PREFIX/share/chroot/sbin/power-shim" "$d/$n" 0755
            fi
        done
    done
    echo $$ >"$(bd_rpath "$BD_ROOT" /run)/bd-session.pid"
    echo batocera >"$(bd_rpath "$BD_ROOT" /etc)/hostname" 2>/dev/null
}

bd_prepare_gpu() {
    BD_GPU_MODE=mesa
    BD_RENDER_NODE=""
    if [[ $BD_GPU != mesa ]] && bd_nvidia_detect; then
        if bd_nvidia_collect; then
            if bd_nvidia_stage; then
                BD_GPU_MODE=nvidia
                if [[ $P_DISPLAY == x11 ]]; then
                    if bd_nvidia_xcollect && bd_nvidia_xstage; then
                        log_info "X11: host nvidia_drv.so + libglxserver_nvidia staged"
                    else log_warn "X11 + NVIDIA: host nvidia_drv.so / libglxserver_nvidia.so.$NV_VER not found or not mountable: Xorg will not be able to use the NVIDIA GPU (BD_GPU=mesa to use another one)"; fi
                fi
                BD_RENDER_NODE=$(bd_render_node nvidia || true)
                log_info "GPU: NVIDIA $NV_VER (host libs linked, ${#NV_LINK[@]} files)"
            fi
        else
            log_warn "NVIDIA module $NV_VER is loaded but its userspace libraries were not found (driver upgraded without a reboot?)"
        fi
    elif [[ $BD_GPU == nvidia ]]; then
        log_warn "BD_GPU=nvidia but no nvidia kernel module is loaded"
    fi
    [[ $BD_GPU_MODE == mesa ]] && log_info "GPU: Mesa (Intel/AMD) using Batocera's own libraries"
}

bd_build_env() {
    BD_ENV=(
        PATH=/usr/bin:/usr/sbin:/bin:/sbin
        HOME=/userdata/system
        TERM="${TERM:-linux}"
        BD_SESSION=1
        BD_MODE="${BD_MODE:-nested}"
        BD_HOST_XDG=/run/host-xdg
        BD_HOST_WAYLAND="${BD_WAYLAND:-}"
        BD_WLR_RENDERER="$BD_WLR_RENDERER"
        BD_LABWC_DEBUG="$BD_LABWC_DEBUG"
        BD_RESOLUTION="$BD_RESOLUTION"
        BD_FULLSCREEN="${BD_FS:-0}"
        BD_XKB_LAYOUT="${BD_XKB_LAYOUT:-${BD_XKB_LAYOUT_HOST:-}}"
        BD_XKB_VARIANT="${BD_XKB_VARIANT:-${BD_XKB_VARIANT_HOST:-}}"
    )
    [[ -n $BD_RENDER_NODE ]] && BD_ENV+=("BD_RENDER_NODE=$BD_RENDER_NODE")
    if [[ $BD_AUDIO == host && -n ${BD_XDG:-} ]]; then
        BD_ENV+=(PULSE_SERVER=unix:/run/host-xdg/pulse/native PIPEWIRE_RUNTIME_DIR=/run/host-xdg)
    fi
    if [[ ${BD_MODE:-nested} == drm && $P_DISPLAY == wayland ]]; then
        [[ -n $BD_DRM_DEVICES ]] && BD_ENV+=(WLR_DRM_DEVICES="$BD_DRM_DEVICES")
        [[ $BD_GPU_MODE == nvidia ]] && BD_ENV+=(WLR_NO_HARDWARE_CURSORS=1)
        # Force the DRM backend and the builtin seat so wlroots never tries X11 or logind
        BD_ENV+=(LIBSEAT_BACKEND=builtin SEAT=seat0)
    fi
    # DISPLAY is only exported for the X11 variants
    if [[ $P_DISPLAY == x11 ]]; then BD_ENV+=(DISPLAY=:1); fi
    [[ -n ${BD_TTY:-} ]] && BD_ENV+=(BD_VT_NUM="${BD_TTY#/dev/tty}")
    if [[ $BD_GPU_MODE == nvidia ]]; then
        BD_ENV+=(
            LD_LIBRARY_PATH=/run/bd-nvidia/lib64
            __EGL_VENDOR_LIBRARY_FILENAMES=/run/bd-nvidia/10_nvidia.json
            __GLX_VENDOR_LIBRARY_NAME=nvidia
            VK_DRIVER_FILES=/run/bd-nvidia/nvidia_icd.json
        )
    fi
}

bd_prepare() {
    mkdir -p "$BD_RUN" "$BD_LOGDIR"
    mount -t tmpfs -o "size=$BD_OVERLAY_SIZE,mode=0755" tmpfs "$BD_RUN" || {
        log_warn "tmpfs mount failed"
        return 1
    }
    bd_mount_layers
    bd_mount_runtime || return 1
    bd_prepare_gpu
    bd_inject_files || return 1
    bd_build_env
}

bd_cr() { # run a command in the chroot with the Batocera environment
    env -i "${BD_ENV[@]}" chroot "$BD_ROOT" "$@"
}

bd_svc() { # service action
    local s=$1 a=$2 f
    [[ -x $(bd_rpath "$BD_ROOT" "/etc/init.d/$s") ]] || {
        log_warn "service $s not found, skipping"
        return 1
    }
    f=$BD_LOGDIR/service-$s.log
    log_info "$s $a (log: $f)"
    timeout 600 env -i "${BD_ENV[@]}" chroot "$BD_ROOT" "/etc/init.d/$s" "$a" </dev/null >>"$f" 2>&1
    local rc=$?
    if ((rc == 0)); then log_ok "$s $a"; else log_warn "$s $a failed (rc=$rc)"; fi
    return $rc
}

# -------------------------------------------------------------------- Bluetooth
bd_bt_start() {
    case $BD_BT in
    host)
        [[ -S /run/dbus/system_bus_socket ]] || {
            log_warn "no system D-Bus: Bluetooth will not work in Batocera"
            return
        }
        bd_cr /bin/sh -c 'a=$(batocera-settings-get bluetooth.adapter 2>/dev/null)
                start-stop-daemon -S -q -m -p /var/run/bluetooth-agent.pid --exec /usr/bin/batocera-bluetooth-agent -- ${a:+--device "$a"} >/dev/null 2>&1 &' \
            </dev/null >>"$BD_LOGDIR/bluetooth.log" 2>&1
        ;;
    exclusive)
        log_warn "exclusive BT (experimental): stopping the host's bluetooth.service"
        systemctl stop bluetooth.service
        bd_svc S30dbus start
        bd_svc S29namebluetooth start
        bd_svc S32bluetooth start
        ;;
    esac
}
bd_bt_stop() {
    case $BD_BT in
    host) bd_cr /bin/sh -c 'start-stop-daemon -K -q -p /var/run/bluetooth-agent.pid' </dev/null >/dev/null 2>&1 ;;
    exclusive)
        bd_svc S32bluetooth stop
        systemctl start bluetooth.service
        ;;
    esac
}

# ---------------------------------------------------------------------- main loop
bd_diag_procs() { # why did the session end? list what is (not) running in the chroot
    local p c a r f=$BD_LOGDIR/session-diag.log
    {
        echo "=== $(date '+%F %T') $1"
        for p in "$BD_ROOT"/proc/[0-9]*; do
            r=$(readlink "$p/root" 2>/dev/null) || continue
            [[ $r == "$BD_ROOT" ]] || continue
            read -r c <"$p/comm" 2>/dev/null || continue
            a=$(tr '\0' ' ' <"$p/cmdline" 2>/dev/null)
            echo "  ${p##*/} comm=$c cmd=${a:0:200}"
        done
    } >>"$f" 2>&1
    log_info "process list saved in $f"
}

bd_wait_session() {
    local t=0 seen=0 miss=0 cgone=0
    while ((! BD_STOP)); do
        if bd_chroot_proc "$P_COMP"; then
            ((seen)) || log_ok "$P_COMP is up"
            ((cgone)) && log_ok "$P_COMP is back"
            seen=1
            cgone=0
        elif ((seen)); then
            if [[ ${BD_MODE:-nested} == drm ]]; then
                # drm: the stock supervisor (emulationstation-standalone) owns and relaunches the
                # graphics server and ES, so short absences are normal: do not kill the session.
                ((cgone == 1)) && log_info "$P_COMP is gone (drm: waiting for the stock loop to relaunch it)"
                ((++cgone == 30)) && log_warn "$P_COMP has not reappeared for 30s; if it does not recover, check display.log and system/varlog/"
            else
                log_info "the display server ($P_COMP) was closed"
                bd_diag_procs "$P_COMP gone"
                break
            fi
        elif ((++t > BD_START_TIMEOUT)); then
            log_err "$P_COMP did not start within ${BD_START_TIMEOUT}s; see /userdata/system/logs/display.log and /var/log/{labwc,Xorg.0}.log inside Batocera"
            BD_RC=1
            break
        fi
        if ((seen)); then
            if bd_chroot_proc emulationstation; then
                miss=0
            elif [[ ${BD_MODE:-nested} == drm ]]; then
                ((++miss == 5)) && log_warn "EmulationStation does not look alive (crash loop or slow start): check /userdata/system/logs/es_log.txt; the drm session stays up"
            elif ((++miss >= 15)); then
                log_info "EmulationStation has exited"
                bd_diag_procs "ES missing (compositor seen)"
                break
            fi
        fi
        sleep 1 &
        wait $!
    done
}

# Audio: Batocera's own tools (batocera-audio, pactl) talk to the HOST's PipeWire-Pulse through
# PULSE_SERVER, so volume, mute, default device and card profile changes made inside Batocera
# are applied to the host directly. What is left is the other direction at start: copy the
# host's current state into batocera.conf (the SHARE partition) so ES shows the same values.
bd_audio_inherit() {
    [[ $BD_AUDIO == host && $BD_AUDIO_SYNC == 1 && -n ${BD_XDG:-} ]] || return 0
    bd_cr /usr/bin/bd-audio-inherit >>"$BD_LOGDIR/audio.log" 2>&1 ||
        log_warn "could not inherit the host audio state (see $BD_LOGDIR/audio.log)"
}

bd_stop_services() {
    local i
    for ((i = ${#SVC_STARTED[@]} - 1; i >= 0; i--)); do bd_svc "${SVC_STARTED[i]}" stop; done
    bd_bt_stop
    bd_kill_chroot_procs TERM
    sleep 2
    bd_kill_chroot_procs KILL
}

cmd_inner() {
    need_root
    trap bd_on_term TERM INT HUP
    trap bd_on_usr1 USR1
    hostname batocera 2>/dev/null # private UTS namespace: the host is unaffected
    if ! bd_prepare; then
        echo exit >"$BD_ACTION_FILE"
        exit 1
    fi
    local s
    log_ok "rootfs, mounts and GPU ready"
    # S04populate runs `ldconfig &` detached ON PURPOSE (slow: "perf issue (boot time)"). The NVIDIA
    # links are staged in bd_prepare, before it, so that run already includes them: do not wait for
    # it and do not run a second full ldconfig (it doubled the start-up cost). Batocera itself
    # does not wait for it. Only if the service started none, run it ourselves.
    if bd_svc S04populate start; then
        sleep 0.2 # let the detached ldconfig fork
        if bd_chroot_proc ldconfig || [[ $(bd_rpath "$BD_ROOT" /etc/ld.so.cache) -nt $BD_RUN/ovl ]]; then
            log_info "ldconfig already started by S04populate (not waiting for it)"
        else
            log_info "S04populate started no ldconfig: running it"
            bd_cr ldconfig >>"$BD_LOGDIR/ldconfig.log" 2>&1
        fi
    fi
    log_ok "base services ready, starting Batocera services"
    bd_bt_start
    for s in $(bd_service_list); do
        s=$(bd_find_service "$s")
        [[ $s == S31emulationstation ]] && bd_audio_inherit
        bd_svc "$s" start && SVC_STARTED+=("$s")
    done
    bd_wait_session
    log_info "closing the session (action: $BD_ACTION)"
    bd_stop_services
    echo "$BD_ACTION" >"$BD_ACTION_FILE"
    exit "$BD_RC"
}

# ------------------------------------------------------- shell / enter / update ...
cmd_enter() {
    need_root
    bd_unshare_args
    [[ ${1:-} == -- ]] && shift
    [[ -n ${SUDO_UID:-} && $SUDO_UID != 0 ]] && export BD_UID=$SUDO_UID BD_XDG=${BD_XDG:-/run/user/$SUDO_UID}
    exec "${BD_UNSHARE[@]}" -- "$BD_PREFIX/libexec/bd-session" __enter "$@"
}

cmd_enter_inner() {
    hostname batocera-maint 2>/dev/null
    bd_running || bd_boot_apply_pending
    # stdout belongs to the command run below: setup messages must not pollute it
    bd_prepare >&2 || exit 1
    if (($#)); then bd_cr "$@"; else bd_cr /bin/bash -l 2>/dev/null || bd_cr /bin/sh; fi
}

cmd_update() { # batocera-desktop update [batocera-upgrade args]
    local -a args=("$@")
    ((${#args[@]})) || args=(--upgrade)
    cmd_enter -- batocera-upgrade "${args[@]}"
}

# Reads usr/share/batocera/batocera.version from the squashfs (loop mount, read-only).
bd_image_version() {
    local t v=""
    t=$(mktemp -d) || return 1
    if mount -o loop,ro "$1" "$t" 2>/dev/null; then
        v=$(head -n1 "$t/usr/share/batocera/batocera.version" 2>/dev/null)
        umount "$t"
    fi
    rmdir "$t" 2>/dev/null
    printf '%s\n' "$v"
}

# A disk image (.img / .img.gz, the way 5.26 is distributed): copy the contents of the first
# (BATOCERA) partition, which holds boot/batocera, into $2.
bd_extract_img() {
    local img=$1 dest=$2 work loop rc=1
    work=$(mktemp -d /var/tmp/bd-img.XXXXXX) || return 1
    if [[ $img == *.gz ]]; then
        gzip -dc <"$img" >"$work/disk.img" || {
            rm -rf "$work"
            return 1
        }
        img=$work/disk.img
    fi
    loop=$(losetup -rfP --show "$img") || {
        rm -rf "$work"
        return 1
    }
    mkdir -p "$work/mnt"
    for _ in 1 2 3 4 5; do
        [[ -b ${loop}p1 ]] && break
        sleep 0.5
    done
    if mount -o ro "${loop}p1" "$work/mnt"; then
        cp -a "$work/mnt/." "$dest/" && rc=0
        umount "$work/mnt"
    fi
    losetup -d "$loop"
    rm -rf "$work"
    return $rc
}

cmd_install() {
    need_root
    local file="" img="" dl=0 variant=$BD_VARIANT type=$BD_UPDATE_TYPE force=0 url="" md5 ver b old
    while (($#)); do
        case $1 in
        --file)
            file=$2
            shift 2
            ;;
        --img)
            img=$2
            shift 2
            ;;
        --download)
            dl=1
            shift
            ;;
        --variant)
            variant=${2:-}
            shift 2
            ;;
        --type)
            type=$2
            shift 2
            ;;
        --force)
            force=1
            shift
            ;;
        *) die "unknown argument: $1" ;;
        esac
    done
    # 1) cancel BEFORE touching anything if this variant does not fit the machine
    bd_hw_probe
    bd_variant_check "$variant" || die "cannot install variant '$variant' here: $BD_WHY. Recommended here: $(bd_variant_recommend)"
    BD_VARIANT=$variant
    if [[ -e $BD_BOOT_DIR/boot/batocera && $force == 0 ]]; then
        die "an installation already exists in $BD_BOOT_DIR (use 'update', or --force to reinstall)"
    fi
    if [[ -e $BD_BOOT_DIR/.bd-variant && $force == 1 ]]; then
        old=$(<"$BD_BOOT_DIR/.bd-variant")
        [[ $old == "$variant" ]] || log_warn "switching $old -> $variant: use a separate BD_USERDATA per variant (5.26 and current configs/gamelists are not compatible)"
    fi
    if ((dl)); then
        case $variant in
        5.26-amd64) url=$BD_URL_526_AMD64 ;;
        5.26-i386) url=$BD_URL_526_I386 ;;
        *) url=$BD_UPDATE_URL/$P_URLPATH/$type/last/boot.tar.xz ;;
        esac
        [[ -n $url ]] || die "no download URL for $variant: set BD_URL_526_AMD64 / BD_URL_526_I386 in $BD_CONF, or pass --file / --img"
        mkdir -p "$BD_USERDATA/system/upgrade"
        file=$BD_USERDATA/system/upgrade/boot.tar.xz
        log_info "downloading $url"
        curl -fL --retry 3 -o "$file" "$url" || die "download failed"
        if md5=$(curl -fsL "$url.md5"); then
            [[ $md5 == "$(md5sum "$file" | cut -d' ' -f1)" ]] || die "md5 mismatch"
        else log_warn "no .md5 file, skipping verification"; fi
    fi
    [[ -n $file || -n $img ]] || die "pass --download, --file boot.tar.xz or --img disk.img[.gz]"
    mkdir -p "$BD_BOOT_DIR" "$BD_USERDATA"
    if [[ -n $img ]]; then
        [[ -f $img ]] || die "no such file: $img"
        log_info "copying the boot partition of $img into $BD_BOOT_DIR"
        bd_extract_img "$img" "$BD_BOOT_DIR" || die "could not read the boot partition of $img"
    else
        [[ -f $file ]] || die "no such file: $file"
        if ! tar -tJf "$file" boot/batocera.board >/dev/null 2>&1; then
            # old images may not ship batocera.board: only require the squashfs
            tar -tJf "$file" boot/batocera >/dev/null 2>&1 || die "this does not look like a Batocera boot.tar.xz"
        fi
        log_info "extracting into $BD_BOOT_DIR"
        xz -dc <"$file" | tar -xf - -C "$BD_BOOT_DIR" --no-same-owner || die "extraction failed"
    fi
    bd_boot_apply_pending
    [[ -f $BD_BOOT_DIR/boot/batocera ]] || die "no boot/batocera in the installed image"
    # 2) the image must really be the variant asked for (board + version), else undo and cancel
    if [[ -f $BD_BOOT_DIR/boot/batocera.board ]]; then
        b=$(<"$BD_BOOT_DIR/boot/batocera.board")
        b=${b//[[:space:]]/}
        if ! bd_board_matches "$b"; then
            rm -rf --one-file-system -- "${BD_BOOT_DIR:?}/boot"
            die "image board is '$b', variant $variant expects: $P_BOARDS (image removed)"
        fi
    else
        log_warn "the image has no boot/batocera.board: board not verified"
    fi
    ver=$(bd_image_version "$BD_BOOT_DIR/boot/batocera")
    if [[ -n $ver && ! $ver =~ $P_VERSION_RE ]]; then
        rm -rf --one-file-system -- "${BD_BOOT_DIR:?}/boot"
        die "image version is '$ver', which is not a '$variant' build (expected like: ${P_VERSION_RE}) (image removed)"
    fi
    [[ -n $ver ]] || log_warn "could not read the image version: version not verified"
    echo "$variant" >"$BD_BOOT_DIR/.bd-variant"
    log_ok "installed: variant=$variant board=$(cat "$BD_BOOT_DIR/boot/batocera.board" 2>/dev/null) version=${ver:-?}"
    log_info "make sure BD_VARIANT=$variant is set in $BD_CONF"
}

cmd_detect() { # no root needed
    bd_hw_probe
    bd_hw_report
}

cmd_doctor() {
    need_root
    local ok=0 bad=0
    chk_pass() {
        log_ok "$1"
        ((ok++))
    }
    chk_fail() {
        log_err "$1" 2>&1 # keep the report on one stream
        ((bad++))
    }
    chk() { # chk DESCRIPTION COMMAND
        if eval "$2" >/dev/null 2>&1; then chk_pass "$1"; else chk_fail "$1"; fi
    }
    echo "== Tools"
    local t
    for t in unshare chroot mount losetup flock xz tar curl timeout python3; do chk "$t" "command -v $t"; done
    echo "== Batocera installation ($BD_BOOT_DIR)"
    chk "boot/batocera (squashfs)" "[[ -f $BD_BOOT_DIR/boot/batocera ]]"
    chk "boot/rufomaculata (second layer)" "[[ -f $BD_BOOT_DIR/boot/rufomaculata ]]"
    bd_hw_probe
    chk "variant $BD_VARIANT fits this machine" "bd_variant_check $BD_VARIANT"
    bd_variant_check "$BD_VARIANT" || log_info "reason: $BD_WHY"
    chk "board: $(cat "$BD_BOOT_DIR/boot/batocera.board" 2>/dev/null) (variant $BD_VARIANT expects: $P_BOARDS)" \
        "bd_assert_image_quiet"
    chk "installed as variant: $(cat "$BD_BOOT_DIR/.bd-variant" 2>/dev/null || echo '?')" "grep -qx '$BD_VARIANT' '$BD_BOOT_DIR/.bd-variant'"
    chk "no unapplied pending update" "[[ ! -e $BD_BOOT_DIR/boot/batocera.update ]]"
    chk "userdata ($BD_USERDATA) exists" "[[ -d $BD_USERDATA ]]"
    echo "== Service"
    if bd_have_systemd; then
        log_info "$BD_UNIT.service: enabled=$(systemctl is-enabled "$BD_UNIT.service" 2>/dev/null || echo no) active=$(systemctl is-active "$BD_UNIT.service" 2>/dev/null)"
        log_info "the service runs in drm mode on the first free VT >= tty$BD_TTY_MIN (tty$(bd_free_vt "$BD_TTY_MIN" || echo '?') right now)"
        chk "BD_USER set (audio for the service)" "[[ -n '$BD_USER' ]]"
    else
        log_info "systemd unit not installed or systemd not running (manual start still works)"
    fi
    log_info "session running now: $(bd_running && echo yes || echo no); active VT: tty$(bd_active_vt || echo '?')"
    echo "== Desktop session (user ${SUDO_USER:-?})"
    local xdg=/run/user/${SUDO_UID:-1000} w="" f
    for f in "$xdg"/wayland-[0-9]*; do
        if [[ -S $f ]]; then
            w=${f##*/}
            break
        fi
    done
    if ((P_NESTED)); then
        chk "Wayland socket (${w:-none})" "[[ -S $xdg/${w:-x} ]]"
    else
        log_info "$BD_VARIANT is X11: tty/standalone mode only, no nested window"
    fi
    chk "PipeWire ($xdg/pipewire-0)" "[[ -S $xdg/pipewire-0 ]]"
    chk "PipeWire-Pulse ($xdg/pulse/native)" "[[ -S $xdg/pulse/native ]]"
    chk "system D-Bus socket" "[[ -S /run/dbus/system_bus_socket ]]"
    chk "bluetooth.service active" "systemctl is-active --quiet bluetooth"
    echo "== GPU"
    if bd_nvidia_detect; then
        log_info "NVIDIA module: $NV_VER"
        chk "nvidia_drm modeset=1" "[[ \$(cat /sys/module/nvidia_drm/parameters/modeset) == Y ]]"
        chk "userspace libraries for $NV_VER found" "bd_nvidia_collect"
        if bd_nvidia_collect; then
            local k
            for k in libGLX_nvidia.so.0 libEGL_nvidia.so.0 libnvidia-allocator.so.1 "libnvidia-glcore.so.$NV_VER" "libnvidia-eglcore.so.$NV_VER"; do
                chk "$k" "[[ -n \${NV_LINK[$k]:-} ]]"
            done
        fi
        log_info "nvidia render node: $(bd_render_node nvidia || echo not-found)"
        if [[ $P_DISPLAY == x11 ]]; then
            chk "X11: host nvidia_drv.so + libglxserver_nvidia.so.$NV_VER (Xorg needs both)" "bd_nvidia_xcollect"
            chk "X11: a PCI BusID for the NVIDIA GPU" "bd_nvidia_busid"
        fi
    else
        log_info "no NVIDIA module: Mesa will be used (nodes: $(find /dev/dri -mindepth 1 -maxdepth 1 -printf '%f ' 2>/dev/null))"
    fi
    echo "== Audio / keys"
    chk "audio mode: $BD_AUDIO, sync with host: $BD_AUDIO_SYNC" "[[ $BD_AUDIO == host ]]"
    log_info "triggerhappy: $BD_TRIGGERHAPPY (auto = drm only), volume keys: $BD_VOLUME_KEYS (step $BD_VOLUME_STEP)"
    echo "== Gamepads"
    chk "/dev/uinput" "[[ -e /dev/uinput ]]"
    chk "uhid module (Bluetooth pads)" "grep -q '^uhid ' /proc/modules || [[ -e /dev/uhid ]]"
    chk "joydev module" "grep -q '^joydev ' /proc/modules"
    echo "== Image (inside the chroot)"
    if [[ -f $BD_BOOT_DIR/boot/batocera ]]; then
        local out l files="/usr/bin/labwc /usr/bin/labwc-launch /usr/bin/wlr-randr"
        [[ $P_DISPLAY == x11 ]] && files="/usr/bin/Xorg /usr/bin/xinit"
        out=$(cmd_enter -- /bin/sh -c '
            for f in '"$files"' /usr/bin/emulationstation \
                     /etc/init.d/S31emulationstation /etc/init.d/S04populate /usr/bin/batocera-upgrade \
                     /usr/bin/batocera-bluetooth-agent /usr/bin/pactl /usr/bin/batocera-audio \
                     /usr/bin/batocera-settings-set; do
                [ -e "$f" ] && echo "OK $f" || echo "NO $f"; done
            echo "VER $(cat /usr/share/batocera/batocera.version 2>/dev/null)"' 2>&1)
        while IFS= read -r l; do
            case $l in
            OK*) chk_pass "${l#OK }" ;;
            NO*) chk_fail "${l#NO }" ;;
            VER*) log_info "image version: ${l#VER }" ;;
            *) echo "$l" ;;
            esac
        done <<<"$out"
    fi
    echo
    if ((bad == 0)); then
        log_ok "Result: $ok OK, $bad failures"
    else
        log_err "Result: $ok OK, $bad failures" 2>&1
    fi
    ((bad == 0))
}

case "${1:-}" in
launch)
    shift
    cmd_launch "$@"
    ;;
run) cmd_run ;;
inner) cmd_inner ;;
shell | enter)
    shift
    cmd_enter "$@"
    ;;
__enter)
    shift
    cmd_enter_inner "$@"
    ;;
update)
    shift
    cmd_update "$@"
    ;;
install)
    shift
    cmd_install "$@"
    ;;
doctor) cmd_doctor ;;
apply-pending)
    need_root
    bd_boot_apply_pending
    ;;
detect) cmd_detect ;;
*) die "unknown subcommand: ${1:-}" ;;
esac
