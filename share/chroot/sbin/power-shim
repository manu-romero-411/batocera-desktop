#!/bin/sh
# batocera-desktop: replaces shutdown/poweroff/reboot/halt inside the chroot.
# It only signals bd-session, which decides (BD_CAN_SHUTDOWN):
#   false (default): reboot -> restarts the Batocera session (applies pending updates)
#                    shutdown/halt/poweroff -> closes Batocera and returns to the desktop
#   true:            reboot / shutdown really reboot / power off the HOST
action=poweroff
case "$(basename "$0")" in reboot) action=reboot ;; esac
for a in "$@"; do
    case "$a" in -r|--reboot) action=reboot ;; esac
done
echo "$action" > /run/bd-action
pid=$(cat /run/bd-session.pid 2>/dev/null) || exit 1
kill -USR1 "$pid"
exit 0
