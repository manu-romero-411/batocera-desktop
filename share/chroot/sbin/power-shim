#!/bin/sh
# batocera-desktop: replaces shutdown/poweroff/reboot/halt inside the chroot.
# reboot   -> restarts the Batocera session (applies pending updates)
# shutdown -> closes Batocera and returns to the desktop (or powers off the host: BD_ON_SHUTDOWN=host)
action=poweroff
case "$(basename "$0")" in reboot) action=reboot ;; esac
for a in "$@"; do
    case "$a" in -r|--reboot) action=reboot ;; esac
done
echo "$action" > /run/bd-action
pid=$(cat /run/bd-session.pid 2>/dev/null) || exit 1
kill -USR1 "$pid"
exit 0
