#!/bin/sh
# batocera-desktop: copy the HOST's audio state into batocera.conf (SHARE partition).
# Runs inside the chroot before EmulationStation starts. batocera-audio/pactl talk to the host's
# PipeWire-Pulse through PULSE_SERVER, so the *current* values are the host's; we only persist
# them where ES looks (audio.device / audio.profile / audio.volume). The squashfs is untouched.
export LC_ALL=C
CONF=/userdata/system/batocera.conf
log() { printf '[%s] bd-audio-inherit: %s\n' "$1" "$2"; }

err=$(pactl info 2>&1 >/dev/null) || {
    log "ERR " "host audio server unreachable (PULSE_SERVER=${PULSE_SERVER:-unset} PULSE_COOKIE=${PULSE_COOKIE:-unset}): $(printf '%s' "$err" | head -n1)"
    exit 1
}
[ -e "$CONF" ] || { log INFO "$CONF does not exist yet, nothing to update"; exit 0; }

dev=$(batocera-audio get 2>/dev/null | head -n1 | cut -f1)
prof=$(batocera-audio get-profile 2>/dev/null | head -n1 | cut -f1)
vol=$(batocera-audio getSystemVolume 2>/dev/null | head -n1)
mute=$(batocera-audio getSystemMute 2>/dev/null | head -n1)

[ -n "$dev" ]  && batocera-settings-set audio.device  "$dev"
[ -n "$prof" ] && batocera-settings-set audio.profile "$prof"
case "$vol" in ''|*[!0-9]*) ;; *) batocera-settings-set audio.volume "$vol" ;; esac
log " OK " "device=${dev:-?} profile=${prof:-?} volume=${vol:-?} mute=${mute:-?}"
exit 0
