#!/bin/sh
# bd-shim-resolution
# batocera-desktop: batocera-resolution for the NESTED labwc (wlroots wayland backend).
#
# The stock script (batocera-resolution.wayland-labwc) reads the size from the "Modes:" list
# of wlr-randr. wlroots' wayland backend has no mode list (only a "custom mode" that follows
# the host window), so wlr-randr prints no size and the stock script answers "unknown" ->
# configgen crashes in int("unknown").
# Here: the real size is measured; the "monitor" is the window and its mode is never changed.
# Everything else (outputs, rotation, getDisplayMode...) is served by the original.
export LC_ALL=C
REAL=${BD_RES_REAL:-/usr/bin/batocera-resolution.real}
STATE=${BD_RES_STATE:-/run/bd-resolution}
LOG=/userdata/system/logs/display.log
_log() { echo "bd-resolution: $*" >> "$LOG" 2>/dev/null; }

PARGS=
if [ "$1" = "--screen" ]; then PARGS="--screen $2"; shift 2; fi
ACTION=$1; [ $# -gt 0 ] && shift
# shellcheck disable=SC2086
_real() { "$REAL" $PARGS "$@"; }

_valid() { echo "$1" | grep -qE '^[0-9]+x[0-9]+$'; }

# 1) wlr-randr (through the original, in case the compositor does list modes)
# 2) PPM header of a grim screenshot: the real window size
# 3) the session default (BD_RESOLUTION)
_size() {
    local s out
    s=$(_real currentResolution 2>/dev/null | head -n1)
    if _valid "$s"; then echo "$s"; return; fi
    out=$(_real currentOutput 2>/dev/null | head -n1)
    s=$(grim -s 1 ${out:+-o "$out"} -t ppm - 2>/dev/null | head -c 24 | sed -n '2s/ /x/p')
    if _valid "$s"; then echo "$s"; return; fi
    s=$(cat "$STATE" 2>/dev/null | head -n1)
    if _valid "$s"; then echo "$s"; return; fi
    echo "${BD_RESOLUTION:-1920x1080}"
}

case "$ACTION" in
    currentResolution)
        _size ;;
    currentMode)
        # original format: WxH.<mHz>; without modes the window has no refresh rate of its own
        m=$(_real currentMode 2>/dev/null | head -n1)
        case "$m" in ""|unknown*) echo "$(_size).60000" ;; *) echo "$m" ;; esac ;;
    listModes)
        l=$(_real listModes 2>/dev/null)
        if [ "$(echo "$l" | grep -c .)" -gt 2 ]; then echo "$l"; else
            sz=$(_size)
            echo "max-1920x1080:maximum 1920x1080"
            echo "max-640x480:maximum 640x480"
            echo "${sz}.60000:${sz} 60.000 Hz"
        fi ;;
    setMode|minTomaxResolution|minTomaxResolution-secure)
        _log "$ACTION $* ignored (nested output: the host window decides the mode)"
        exit 0 ;;
    *)
        _real "$ACTION" "$@" ;;
esac
