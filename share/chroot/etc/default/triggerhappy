# --- batocera-desktop begin (generated; everything below this line is replaced on each start) ---
# Sourced by /etc/init.d/S50triggerhappy. Adds volume (and brightness) keys to the key map in use
# (Batocera's stock one, or the user's multimedia_keys.conf): pressing acts at once and holding
# repeats (bd-key-act drops repeats while the previous action still runs). A key the map already
# binds is left alone, so the user's own lines win. hotkeygen's own volume binding is removed
# from its mapping by bd-session, otherwise every press would count twice.
BD_KEYS=/run/bd-multimedia_keys.conf
bd_has_key() { grep -qE "^[[:space:]]*$1([[:space:]+]|\$)" "$CONFPATH" 2>/dev/null; }
bd_bind() { # KEY ACTION_ON_PRESS [ACTION_ON_REPEAT]
    bd_has_key "$1" && return 0
    echo "$1 1 $2"
    [ -n "$3" ] && echo "$1 2 $3"
}
{
    cat "$CONFPATH"
@LINES@
} > "$BD_KEYS"
DAEMON_ARGS="--daemon --triggers $BD_KEYS --socket /var/run/thd.socket --pidfile $PIDFILE /dev/input/event*"
